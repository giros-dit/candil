@prefix candil-if: <https://w3id.org/candil/interface#> .
@prefix candil-tp: <https://w3id.org/candil/topology#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix mod: <https://w3id.org/mod#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema1: <http://www.owl-ontologies.com/schema#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dcterms:created a owl:AnnotationProperty .

dcterms:creator a owl:AnnotationProperty .

dcterms:description a owl:AnnotationProperty .

dcterms:license a owl:AnnotationProperty .

dcterms:publisher a owl:AnnotationProperty .

dcterms:title a owl:AnnotationProperty .

vann:preferredNamespacePrefix a owl:AnnotationProperty .

vann:preferredNamespaceUri a owl:AnnotationProperty .

schema1:codeRepository a owl:AnnotationProperty .

owl:priorVersion a owl:AnnotationProperty .

owl:versionIRI a owl:AnnotationProperty .

owl:versionInfo a owl:AnnotationProperty .

candil-if: a owl:Ontology ;
    dcterms:created "2024-02-05"^^xsd:date ;
    dcterms:creator "Ignacio Dominguez Martinez-Casanueva (https://orcid.org/0000-0002-8573-127X)" ;
    dcterms:description "An ontology for representing network topologies" ;
    dcterms:license <http://purl.org/NET/rdflicense/APACHE2.0> ;
    dcterms:publisher <https://github.com/giros-dit> ;
    dcterms:title "The CANDIL Ontology – Topology" ;
    vann:preferredNamespacePrefix "candil-tp" ;
    vann:preferredNamespaceUri candil-tp: ;
    schema1:codeRepository "https://github.com/giros-dit/candil"^^xsd:anyURI ;
    owl:priorVersion <https://w3id.org/candil/topology> ;
    owl:versionIRI <https://w3id.org/candil/topology> ;
    owl:versionInfo "1.0.0" ;
    mod:createdWith <https://chowlk.linkeddata.es/> .

candil-tp:connectsNode a owl:ObjectProperty ;
    rdfs:label "connects node" ;
    rdfs:domain candil-tp:Link ;
    rdfs:range candil-tp:Node .

candil-tp:inNode a owl:ObjectProperty ;
    rdfs:label "in node" ;
    rdfs:domain candil-tp:TerminationPoint ;
    rdfs:range candil-tp:Node .

candil-tp:isCointainedInNetwork a owl:ObjectProperty ;
    rdfs:label "is cointained in network" ;
    rdfs:domain candil-tp:Node ;
    rdfs:range candil-tp:Network .

candil-tp:linkIdentifier a owl:DatatypeProperty ;
    rdfs:label "link identifier" ;
    rdfs:domain candil-tp:Link ;
    rdfs:range xsd:string .

candil-tp:networkIdentifier a owl:DatatypeProperty ;
    rdfs:label "network identifier" ;
    rdfs:domain candil-tp:Network ;
    rdfs:range xsd:string .

candil-tp:nodeIdentifier a owl:DatatypeProperty ;
    rdfs:label "node identifier" ;
    rdfs:domain candil-tp:Node ;
    rdfs:range xsd:string .

candil-tp:terminatesLink a owl:ObjectProperty ;
    rdfs:label "terminates link" ;
    rdfs:domain candil-tp:TerminationPoint ;
    rdfs:range candil-tp:Link .

candil-tp:terminationPointIdentifier a owl:DatatypeProperty ;
    rdfs:label "termination point identifier" ;
    rdfs:domain candil-tp:TerminationPoint ;
    rdfs:range xsd:string .

candil-tp:Network a owl:Class ;
    rdfs:label "Network" .

candil-tp:Link a owl:Class ;
    rdfs:label "Link" .

candil-tp:TerminationPoint a owl:Class ;
    rdfs:label "Termination Point" .

candil-tp:Node a owl:Class ;
    rdfs:label "Node" .
