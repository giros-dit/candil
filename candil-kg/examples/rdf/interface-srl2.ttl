<http://example.org/Node/srl2/Interface/e1-1> a candil-if:Interface;
  candil-if:interfaceName "e1-1";
  candil-if:adminStatus candil-if:InterfaceStatusUP;
  candil-if:operStatus candil-if:InterfaceStatusUP;
  candil-if:hasInterfaceStatistics <http://example.org/Node/srl2/Interface/e1-1/InterfaceStatistics> .

<http://example.org/Node/srl2/Interface/e1-1/InterfaceStatistics> a candil-if:InterfaceStatistics;
  candil-if:inputOctets "8157"^^xsd:integer;
  candil-if:inputUnicastPackets "94"^^xsd:integer;
  candil-if:inputDiscards "0"^^xsd:integer;
  candil-if:inputErrors "0"^^xsd:integer;
  candil-if:outOctets "89363"^^xsd:integer;
  candil-if:outputUnicastPackets "209"^^xsd:integer;
  candil-if:outputDiscards "0"^^xsd:integer;
  candil-if:outputErrors "0"^^xsd:integer .
