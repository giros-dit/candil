#set ($interfaces = $reader.getDataframe('{
    "iterator": "$.*",
    "paths": {
        "name": "tags.interface_name",
        "operStatus": "values[\"/openconfig-interfaces:interfaces/interface/state/oper-status\"]",
    }
}'))

#foreach($interface in $interfaces)

#set ($operStatus = $interface.operStatus.toUpperCase())

<Node/srl1/Interface/${interface.name}> a candil-if:Interface ;
    candil-if:interfaceName "$interface.name" ;
    candil-if:operStatus candil-if:InterfaceStatus${operStatus} ;
.

#end
